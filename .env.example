# Copy to .env for local use. Never commit .env.
# CloudRecon reads AWS credentials only from the standard AWS credential chain
# (environment variables already present in the shell, shared config, or a role).
# Do not put access keys in this file.

CLOUDRECON_MODE=demo
CLOUDRECON_DATABASE_PATH=data/cloudrecon.db
CLOUDRECON_INTEL_OFFLINE=true
CLOUDRECON_ALLOW_LIVE_SCAN=false
CLOUDRECON_ALLOW_NMAP=false
CLOUDRECON_ENABLE_INSPECTOR=false
CLOUDRECON_ENABLE_JIRA=false
CLOUDRECON_JIRA_BASE_URL=
CLOUDRECON_JIRA_EMAIL=
CLOUDRECON_JIRA_API_TOKEN=
CLOUDRECON_JIRA_PROJECT=
CLOUDRECON_WEBHOOK_URL=
CLOUDRECON_NVD_API_KEY=
CLOUDRECON_LOG_LEVEL=INFO
CLOUDRECON_SCOPE_PATH=config/scope.example.yaml
